{
  "name": "clawdbot-railway-template",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "lint": "node --check src/server.js && node --check src/setup-app.js && node --check src/agent-packs.js && node --check scripts/agent-pack.js && node --check scripts/evidence-brief.js",
    "test": "node --test",
    "smoke": "node scripts/smoke.js",
    "brief": "node scripts/evidence-brief.js",
    "pack:verify": "node scripts/agent-pack.js verify",
    "iac:check": "tsc -p tsconfig.iac.json"
  },
  "dependencies": {
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "tar": "^7.5.4"
  },
  "devDependencies": {
    "railway": "3.12.0",
    "typescript": "5.9.3"
  }
}
